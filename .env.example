# Server
PORT=3000

# Railway PostgreSQL
# In Railway prefer a reference variable instead of pasting the actual password:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
PGSSL=auto
PGPOOL_MAX=5

# Media persistence
# With DATABASE_URL configured, admin-uploaded images/videos are stored durably in PostgreSQL.
# UPLOAD_DIR is only a local cache / development fallback; a Railway Volume is no longer required.
# Railway/production refuses new media uploads if PostgreSQL is not connected, so files cannot be silently lost on redeploy.
REQUIRE_PERSISTENT_MEDIA=true
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=60

# SMTP / email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=DEMI DEVILLE <shop@example.com>
SUPPORT_TO=support@example.com

# IMAP / incoming email shown in Admin -> Mail
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
# Stripe Checkout (keep live secrets only in Railway Variables; never commit real keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_SITE_URL=https://www.demideville.com

